// số học, số thực, chuỗi, drive, toán tử logic
global {
    int gcount = 0;
}

var {
    db int a = 6;
    db float b = 7.3667;
    db string name = "Jack";
    db drive number = "1", "2", "3", name, a;
    db string ten = "Peter";
    db string ho = "Griffin";
    db drive foods = "apple", "fish", "potato";
}

entry {
    msg "a-b=" + (a - b) + "\n";
    msg "a+b=" + (a + b) + "\n";
    msg "a*b=" + (a * b) + "\n";
    msg "a/b=" + (a / b) + "\n";
    msg "7/2=" + (7 / 2) + "\n";
    msg "6/3=" + (6 / 3) + "\n";
    msg "2^10=" + (2 ^ 10) + "\n";
    msg "15000^69=" + (15000 ^ 69) + "\n";
    msg "0.1+0.2=" + (0.1 + 0.2) + "\n";
    msg "1/3=" + (1 / 3) + "\n";
    msg "-5%3=" + (0 - 5) % 3 + "\n";
    msg number;
    msg "\n";
    msg len ten;
    msg "\n";
    msg "my name is: " + ten ho + "\n";
    msg element foods;
    msg "\n";
    msg a == 6, green;
    msg "\n";
    msg a != 6 or b > 7;
    msg "\n";
    msg nil;
    msg "\n";
    gcount = gcount + 41;
    gcount = gcount + 1;
    msg gcount;
    msg "\n";
}
